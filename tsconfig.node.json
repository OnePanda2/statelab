{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    // Build-tooling configs use `import.meta.url` and Node builtins. Without the
    // Node types these resolve to `any`, which then trips the `no-unsafe-*` lint
    // rules — the failure `npm run lint` was reporting before CI was added.
    "types": ["node"]
  },
  "include": ["vite.config.ts", "vitest.config.ts", "tailwind.config.ts"]
}
